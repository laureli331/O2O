page { min-height: 100%; background: #f4f6f8; color: #20252b; font-family: sans-serif; }
.page { padding: 32rpx 28rpx 64rpx; }
.card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; }
.title { margin-bottom: 12rpx; font-size: 38rpx; font-weight: 700; }
.subtitle, .hint { color: #6c747e; font-size: 26rpx; line-height: 1.6; }
.button { margin-top: 22rpx; border-radius: 12rpx; font-size: 29rpx; }
.button::after { border: 0; }
.button-primary { background: #08bf73; color: #fff; }
.button-hover { transform: scale(.985); opacity: .88; }
.report { margin-top: 20rpx; padding: 22rpx; border-radius: 14rpx; background: #eef2f6; color: #303943; font-family: monospace; font-size: 23rpx; line-height: 1.65; overflow-wrap: anywhere; white-space: pre-wrap; }
