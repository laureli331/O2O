page {
  min-height: 100%;
  background: #f5f6f8;
  color: #17202a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(18, 36, 54, 0.05);
}

.title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.subtitle,
.hint {
  color: #697586;
  font-size: 26rpx;
  line-height: 1.55;
}

.section-title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.field-label {
  display: block;
  margin: 18rpx 0 8rpx;
  color: #4b5563;
  font-size: 25rpx;
}

.field-value {
  box-sizing: border-box;
  overflow-wrap: anywhere;
  min-height: 72rpx;
  padding: 18rpx;
  border: 1rpx solid #d8dee7;
  border-radius: 12rpx;
  color: #344054;
  background: #f8fafc;
  font-size: 26rpx;
}

input,
textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx;
  border: 1rpx solid #d8dee7;
  border-radius: 12rpx;
  background: #fff;
  font-size: 26rpx;
}

textarea {
  min-height: 210rpx;
  line-height: 1.45;
}

.button {
  margin: 18rpx 0 8rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.button-primary {
  color: #fff;
  background: #08a85a;
}

.button-secondary {
  color: #12633d;
  background: #e9f7ef;
}

.button-danger {
  color: #a82c2c;
  background: #fff1f0;
}

.button-hover {
  transform: scale(0.985);
  opacity: 0.86;
}

.report {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  padding: 18rpx;
  border-radius: 12rpx;
  color: #344054;
  background: #f1f4f7;
  font-family: monospace;
  font-size: 23rpx;
  line-height: 1.5;
}

.warn {
  color: #8a4b08;
}
